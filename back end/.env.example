# Copy to `.env` for local development, or set these as Environment Variables
# in the Vercel project settings (Settings → Environment Variables).

# --- Supabase Postgres (required) -----------------------------------------
# DB1 — raw data + Phase A analytics
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# DB2 — application analytics, classifications, AI analysis
DB2_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Supabase REST / storage (optional) -----------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DB2_URL=https://<project-ref>.supabase.co
DB2_SECRET_KEY=
DB2_SERVICE_ROLE_KEY=

# --- API (optional) --------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins.
# On Vercel the frontend and API are same-origin, so CORS is not required.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
